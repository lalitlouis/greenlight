# ---- Parallel (partner track requirement: Search API must be called at runtime) ----
PARALLEL_API_KEY=

# ---- Google Cloud / Vertex AI ----
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Staging bucket for Agent Engine deploys (gs://...)
GREENLIGHT_STAGING_BUCKET=

# ---- ClickHouse Cloud (plain database; NOT the submitted track) ----
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=greenlight
CLICKHOUSE_SECURE=true
