{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenlight.dev/schemas/report.schema.json",
  "title": "Report",
  "description": "The Production Risk Report. Top-level deliverable rendered by the web app.",
  "type": "object",
  "required": [
    "script_title",
    "generated_at",
    "greenlight_score",
    "flags",
    "counts"
  ],
  "additionalProperties": false,
  "properties": {
    "script_title": {
      "type": "string"
    },
    "page_count": {
      "type": "number"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "greenlight_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "0-100. Deterministic function of flag severities \u2014 never asked of an LLM."
    },
    "counts": {
      "type": "object",
      "required": [
        "BLOCKER",
        "HIGH",
        "MEDIUM",
        "LOW",
        "FYI"
      ],
      "additionalProperties": false,
      "properties": {
        "BLOCKER": {
          "type": "integer"
        },
        "HIGH": {
          "type": "integer"
        },
        "MEDIUM": {
          "type": "integer"
        },
        "LOW": {
          "type": "integer"
        },
        "FYI": {
          "type": "integer"
        }
      }
    },
    "by_agent": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "est_clearance_cost_usd": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "est_added_days": {
      "type": [
        "number",
        "null"
      ]
    },
    "rating_prediction": {
      "type": [
        "object",
        "null"
      ],
      "description": "Ratings Board output. Evidence-based: nearest released-film content profiles from ClickHouse (Wikipedia-derived, real ratings attached) plus the measured CARA boundary \u2014 not an LLM guess.",
      "required": [
        "predicted",
        "comparables"
      ],
      "additionalProperties": false,
      "properties": {
        "predicted": {
          "type": "string",
          "enum": [
            "G",
            "PG",
            "PG-13",
            "R",
            "NC-17"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": "string",
          "description": "In CARA house style."
        },
        "comparables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "rating",
              "rationale",
              "distance"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "year": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "rating": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "distance": {
                "type": "number"
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "beats_to_cut": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What to change to hit the target rating."
        },
        "corpus_base_rates": {
          "type": "object",
          "description": "Rating -> percent of the whole corpus, the base-rate denominator for the comparables panel.",
          "additionalProperties": {
            "type": "number"
          }
        },
        "distance_spread": {
          "type": [
            "number",
            "null"
          ],
          "description": "max-min cosine distance across the comparables; a tight spread means the neighbourhood is not discriminating."
        },
        "comps_majority": {
          "type": "string",
          "description": "Distance-weighted majority rating of the comparables \u2014 the evidence's own verdict."
        },
        "divergence_reason": {
          "type": "string",
          "description": "Why the desk's prediction differs from comps_majority; empty when it follows the evidence."
        },
        "nearest_conflict": {
          "type": [
            "object",
            "null"
          ],
          "description": "Set when the closest comparable sits at near-identity distance with a different rating \u2014 the desk was required to address it.",
          "properties": {
            "title": {
              "type": "string"
            },
            "rating": {
              "type": "string"
            },
            "distance": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "conformal_set": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "G",
              "PG",
              "PG-13",
              "R",
              "NC-17"
            ]
          },
          "description": "Mondrian conformal prediction set at 90% coverage, from the measured CARA boundary. The guarantee the report leads with; the point prediction is the desk's call within (or explicitly diverging from) it."
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "https://greenlight.dev/schemas/flag.schema.json"
      }
    },
    "dimension_scores": {
      "type": [
        "object",
        "null"
      ],
      "description": "Per-desk 0-100 scores, same deterministic function as greenlight_score restricted to that desk's flags. Defensible where one number is not.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    }
  }
}