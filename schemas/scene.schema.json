{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenlight.dev/schemas/scene.schema.json",
  "title": "Scene",
  "description": "One slugline-delimited scene. The anchor every flag points back to.",
  "type": "object",
  "required": [
    "scene_id",
    "page",
    "heading",
    "int_ext",
    "location",
    "time_of_day",
    "action",
    "raw_span"
  ],
  "additionalProperties": false,
  "properties": {
    "scene_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,4}$",
      "description": "Stable id, e.g. S014."
    },
    "page": {
      "type": "number",
      "minimum": 0,
      "description": "Approx page number; 1 page ~= 1 minute of screen time."
    },
    "heading": {
      "type": "string",
      "description": "Raw slugline, e.g. 'INT. DINER - NIGHT'."
    },
    "int_ext": {
      "type": "string",
      "enum": [
        "INT",
        "EXT",
        "INT/EXT",
        "UNKNOWN"
      ]
    },
    "location": {
      "type": "string"
    },
    "time_of_day": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "Concatenated action/description lines."
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "character",
          "line"
        ],
        "additionalProperties": false,
        "properties": {
          "character": {
            "type": "string"
          },
          "parenthetical": {
            "type": "string"
          },
          "line": {
            "type": "string"
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_span": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "[start,end) char offsets into the source script. Drives the marked-up script view."
    },
    "number": {
      "type": "string",
      "description": "The script's own scene number (FDX Number attribute or Fountain #42# syntax). Absent when the draft is unnumbered and scene_id is a generated coordinate."
    }
  }
}
